<button id="theme-btn" aria-label="Toggle theme" title="Toggle theme">
  <span id="theme-icon" aria-hidden="true" style="display:inline-flex"></span>
  <span id="theme-label" style="font-size:.875rem;opacity:.8"></span>
</button>

<script is:inline>
  const KEY = "starlight-theme";

  const prefersDark = () =>
    window.matchMedia &&
    window.matchMedia("(prefers-color-scheme: dark)").matches;

  const getStoredPref = () => {
    try {
      return localStorage?.getItem(KEY) || "auto";
    } catch {
      return "auto";
    }
  };

  const setStoredPref = (pref) => {
    localStorage?.setItem(KEY, pref);
  };

  // Applied theme is what the CSS should see; preference can be 'auto'
  const applyTheme = (pref) => {
    const html = document.documentElement;
    const applied = pref === "auto" ? (prefersDark() ? "dark" : "light") : pref;
    html.setAttribute("data-theme", applied);
    html.setAttribute("data-theme-preference", pref); // handy for styling/icons
    updateButton(pref);
  };

  const icons = {
    auto: (size) => `
      <svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="#CCCCCC">
        <path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" stroke-width="1.5"/>
      </svg>`,
    light: (size) => `
      <svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="#CCCCCC">
        <circle cx="12" cy="12" r="4" stroke-width="1.5"/>
        <path d="M12 2v2m0 16v2M4 12H2m20 0h-2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M5 19l1.5-1.5" stroke-width="1.5"/>
      </svg>`,
    dark: (size) => `
      <svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="#CCCCCC">
        <path d="M20 12.5A8 8 0 1 1 11.5 4 6.5 6.5 0 0 0 20 12.5Z" stroke-width="1.5"/>
      </svg>`,
  };

  const updateButton = (pref) => {
    console.log("Update button", pref);
    const icon = document.getElementById("theme-icon");
    const label = document.getElementById("theme-label");
    icon.innerHTML = icons[pref](28);
    label.textContent = pref[0].toUpperCase() + pref.slice(1);
  };

  const nextPref = (pref) =>
    pref === "auto" ? "light" : pref === "light" ? "dark" : "auto";

  // --- Init -----------------------------------------------------------------
  let pref = getStoredPref();
  applyTheme(pref);

  // Keep in sync with system if preference is 'auto'
  let mql = window.matchMedia("(prefers-color-scheme: dark)");
  const mqlHandler = () => {
    if (pref === "auto") applyTheme(pref);
  };
  mql.addEventListener?.("change", mqlHandler);

  // Keep in sync with other pages / Starlight’s built-in picker
  window.addEventListener("storage", (e) => {
    if (e.key === KEY && e.newValue && e.newValue !== pref) {
      pref = e.newValue;
      applyTheme(pref);
    }
  });

  document.getElementById("theme-btn").addEventListener("click", () => {
    pref = nextPref(pref);
    setStoredPref(pref);
    applyTheme(pref);
  });
</script>

<style>
  button {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(currentColor);
    border-radius: 0.75rem;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    font: inherit;
  }
</style>
