---
import Button from "../ui/Button.astro";

const { content } = Astro.props;
---

<div class="cookie-popup" id="cookie-popup">
  <h3 class="title">{content.title}</h3>
  <p class="text">
    {content.text}
    <a href={content.readMoreHref} class="read-more-link"
      >{content.readMoreText}</a
    >
  </p>
  <div class="buttons">
    <Button variant="secondary sm" class="cookie-button">Reject all</Button>

    <Button variant="sm" class="cookie-button">Accept all</Button>
  </div>
</div>

<style lang="sass">
  @use '../../styles/mixins' as *

  .cookie-popup
    z-index: 100
    position: fixed
    bottom: 16px
    right: 0
    margin: 0 16px
    width: calc(100% - 32px)
    padding: 24px 24px 16px
    background-color: var(--hh-cookie-bg)
    box-shadow: 0px 0px 6px 0px var(--hh-cookie-shadow)
    display: flex
    flex-direction: column
    max-width: 100%
    font-family: var(--font-code)

    +dark
      background-color: var(--hh-cookie-bg-dark)
      box-shadow: 0px 0px 6px 0px var(--hh-cookie-shadow-dark)

    +sm
      margin: 0 24px
      bottom: 24px
      max-width: 332px

    &.hidden
      display: none

  .title
    font-weight: 700
    font-size: 12px
    line-height: 1.5
    letter-spacing: 0.05em
    color: var(--hh-gray8b)
    margin: 0

    +dark
      color: var(--hh-gray2)

  .text
    margin-top: 8px
    font-weight: 400
    font-size: 10px
    line-height: 1.5
    font-family: var(--font-base)
    letter-spacing: 0.045em
    color: var(--hh-cookie-text)
    margin-bottom: 0

    +dark
      color: var(--hh-cookie-text-dark)

  .read-more-link
    margin-left: 4px
    cursor: pointer
    color: inherit
    text-decoration: none

    &:hover
      opacity: 0.8

  .buttons
    display: flex
    gap: 16px
    margin-top: 16px
    .cta
      width: auto
</style>
