---
import "../styles/global.css";
import Banner from "../components/Banner/Banner.astro";
import LandingHeader from "../components/LandingHeader/LandingHeader.astro";
import HeroBlock from "../components/HeroBlock/HeroBlock.astro";
import HardhatNews from "../components/HardhatNews/HardhatNews.astro";
import WhatIsNewBlock from "../components/WhatIsNewBlock/WhatIsNewBlock.astro";
import EmailForm from "../components/EmailForm/EmailForm.astro";
import Footer from "../components/Footer/Footer.astro";
import WhyHardhat from "../components/WhyHardhat/WhyHardhat.astro";
import CookiePopup from "../components/CookiePopup/CookiePopup.astro";
import { getEntry } from "astro:content";
import { getHardhatReleases } from "../lib/getHardhatReleases";
import { getPosts } from "../lib/getPosts";
import { landing } from "../config";

const title =
  "Hardhat | Ethereum development environment for professionals by Nomic Foundation";
const description =
  "Hardhat is an Ethereum development environment. Compile your contracts and run them on a development network. Get Solidity stack traces, console.log and more.";
const canonicalUrl = "https://hardhat.org";

const heroData = await getEntry("hero", "data");
const whyHardhatData = await getEntry("why-hardhat", "data");

if (!heroData) {
  throw new Error("Hero data not found in hero collection");
}

if (!whyHardhatData) {
  throw new Error(
    "WhyHardhat data not found in why-hardhat collection",
  );
}

// Fetch data from external APIs
const releases = await getHardhatReleases();
const posts = await getPosts();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:url" content="https://hardhat.org" />
    <meta property="og:image" content="/thumbnail.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Preload Fonts -->
    <link
      rel="preload"
      href="/fonts/Roboto-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Roboto-SemiBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Roboto-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/SourceCodePro-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/SourceCodePro-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <Banner />
    <LandingHeader />

    <main class="main">
      <HeroBlock content={heroData.data} />
      <WhyHardhat content={whyHardhatData.data} />
      <WhatIsNewBlock content={{ title: landing.whatIsNew.title, releases }} />
      <HardhatNews content={{ title: landing.hardhatNews.title, posts }} />
      <EmailForm content={{ title: landing.emailForm.title }} />
    </main>
    <Footer content={landing.footer} />
    <CookiePopup content={landing.cookiePopup} />
  </body>
</html>
